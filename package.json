{
  "name": "news_app",
  "version": "0.2.0",
  "description": "無料で使えるニュースまとめアプリ（Google News RSS / Cloudflare Workers）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply news-app --local",
    "db:migrate:remote": "wrangler d1 migrations apply news-app --remote"
  },
  "devDependencies": {
    "wrangler": "^4.143.0"
  }
}
