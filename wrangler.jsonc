{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-app",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // public/ を静的アセットとして配信する。該当ファイルがないパス（/api/* など）だけ Worker が処理する
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
